[Unit]
Description=odotoken - AI Token Proxy and Cost Metering Service
After=network.target

# TEMPLATE — do not install this file by hand if your project is not at
# ~/odotoken. Instead, from the project root run:
#     odotoken install-service
# which writes ~/.config/systemd/user/odotoken.service with the correct
# absolute paths, then:
#     systemctl --user daemon-reload && systemctl --user enable --now odotoken

[Service]
Type=simple
WorkingDirectory=%h/odotoken
ExecStart=%h/odotoken/.venv/bin/odotoken start --host 127.0.0.1 --port 8090
Restart=always
RestartSec=3
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=default.target