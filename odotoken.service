[Unit]
Description=odotoken - AI Token Proxy and Cost Metering Service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/odotoken
ExecStart=%h/odotoken/bin/odotoken start --host 127.0.0.1 --port 8090 --config %h/.config/odotoken/config.json --db %h/.local/share/odotoken/odotoken.db
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
