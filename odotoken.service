[Unit]
Description=odotoken - AI Token Proxy and Cost Metering Service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/odotoken
ExecStart=%h/odotoken/.venv/bin/python -m odotoken.cli start --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=default.target
