{
  "proxy": {
    "host": "127.0.0.1",
    "port": 8090,
    "upstream_openai": "http://127.0.0.1:8791",
    "upstream_anthropic": "http://127.0.0.1:8082",
    "upstream_gemini": "https://generativelanguage.googleapis.com",
    "upstream_ollama": "http://127.0.0.1:11434"
  },
  "providers": {
    "anthropic": {
      "upstream_url": "http://127.0.0.1:8082"
    },
    "openai": {
      "upstream_url": "http://127.0.0.1:8791"
    },
    "gemini": {
      "upstream_url": "https://generativelanguage.googleapis.com"
    },
    "ollama": {
      "upstream_url": "http://127.0.0.1:11434"
    },
    "kodeo": {
      "upstream_url": "https://api.kodeo.com.br/v1"
    },
    "kodeo-cc": {
      "upstream_url": "https://api.kodeo.com.br/v1"
    },
    "verboo": {
      "upstream_url": "https://code.verboo.ai/router/v1"
    },
    "cheapestinference": {
      "upstream_url": "https://api.cheapestinference.com/v1"
    },
    "useoneai": {
      "upstream_url": "https://api.useoneai.app/v1"
    },
    "pegasus": {
      "upstream_url": "https://api.pegasusrelay.com/v1"
    }
  },
  "limits": {
    "daily_cost_limit_usd": 10.0,
    "monthly_cost_limit_usd": 100.0,
    "daily_tokens_limit": 50000,
    "monthly_tokens_limit": 500000,
    "action_on_breach": "alert",
    "projects": {
      "my-app": {
        "daily_cost_limit_usd": 5.0,
        "monthly_cost_limit_usd": 50.0,
        "daily_tokens_limit": 20000,
        "action_on_breach": "block"
      },
      "experiment": {
        "daily_cost_limit_usd": 2.0,
        "action_on_breach": "alert"
      }
    },
    "rate_limit": {
      "requests_per_min": 0,
      "tokens_per_min": 0
    },
    "alerts": {
      "slack_url": "",
      "discord_url": "",
      "telegram": {
        "bot_token_env": "ODO_TELEGRAM_TOKEN",
        "chat_id": ""
      },
      "email": {
        "smtp_host": "",
        "port": 587,
        "to": "",
        "user_env": "ODO_SMTP_USER",
        "pass_env": "ODO_SMTP_PASS"
      }
    }
  },
  "cache": {
    "semantic": {
      "enabled": false,
      "ttl_seconds": 3600
    }
  },
  "auth": {
    "bearer_token_env": "ODO_DASH_TOKEN",
    "basic": {
      "user": "",
      "pass_env": "ODO_DASH_PASS"
    }
  },
  "otel": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:4317"
  },
  "database": {
  },
  "token_counter": {
    "enabled": true,
    "default_model": "gpt-4o-mini",
    "default_provider": "openai",
    "cache_enabled": true,
    "cache_ttl_seconds": 3600,
    "cache_max_size": 10000,
    "providers": {
      "openai": {
        "enabled": false,
        "api_key_env": "OPENAI_API_KEY",
        "base_url": "http://127.0.0.1:8791",
        "count_endpoint": "/v1/tokens/count"
      },
      "anthropic": {
        "enabled": false,
        "api_key_env": "ANTHROPIC_API_KEY",
        "base_url": "http://127.0.0.1:8082",
        "count_endpoint": "/v1/messages/count_tokens"
      },
      "gemini": {
        "enabled": false,
        "api_key_env": "GEMINI_API_KEY",
        "base_url": "https://generativelanguage.googleapis.com",
        "count_endpoint": "/v1/models/{model}:countTokens"
      },
      "ollama": {
        "enabled": false,
        "base_url": "http://127.0.0.1:11434"
      }
    },
    "heuristic": {
      "chars_per_token": 4.0,
      "words_per_token": 0.75
    }
  },
  "privacy": {
    "redact_logs": true,
    "store_prompts": false,
    "block_mode": false,
    "custom_patterns": []
  },
  "sessions": {
    "enabled": true,
    "paths": {
      "claude": "~/.claude/projects",
      "codex": "~/.codex/sessions",
      "omp": "~/.omp/stats.db",
      "crush": "~/.local/share/crush/projects.json"
    }
  }
}
