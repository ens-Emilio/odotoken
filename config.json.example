{
  "server": {
    "bind_host": "127.0.0.1",
    "api_key": "change-me-or-use-ODO_API_KEY",
    "client_keys": {
      "odt_change_me_example_key": { "client": "example", "project": "default" }
    },
    "cors_allowlist": ["http://localhost:5173"]
  },
  "providers": {
    "openai": {
      "upstream_url": "https://api.openai.com",
      "fallbacks": [],
      "fallback_on_status": [429, 500, 502, 503, 504]
    },
    "anthropic": { "upstream_url": "https://api.anthropic.com" },
    "gemini": { "upstream_url": "https://generativelanguage.googleapis.com" },
    "ollama": { "upstream_url": "http://127.0.0.1:11434" },
    "relay": { "upstream_url": "https://your-relay.example/v1", "fallbacks": ["openai"] }
  },
  "guard": {
    "daily_cost_limit_usd": 0,
    "monthly_cost_limit_usd": 0,
    "daily_tokens_limit": 0,
    "monthly_tokens_limit": 0,
    "warning_threshold_pct": 80,
    "action_on_breach": "block",
    "timezone": "UTC",
    "projects": {
      "batch": { "daily_cost_limit_usd": 5, "monthly_cost_limit_usd": 50 }
    }
  },
  "limits": {
    "rate_limit": {
      "enabled": false,
      "rps": 10,
      "burst_size": 20,
      "projects": { "batch": { "rps": 2, "burst_size": 4 } },
      "clients": { "claude": { "rps": 5 } }
    }
  },
  "alerts": {
    "webhook_url": "",
    "slack_url": "",
    "discord_url": "",
    "telegram": { "bot_token_env": "ODO_TELEGRAM_TOKEN", "chat_id": "" },
    "email": { "smtp_host": "", "smtp_port": 587, "username": "", "password": "", "from_addr": "", "to_addr": "" },
    "retry": { "max_attempts": 5, "base_delay_seconds": 30, "max_delay_seconds": 3600 }
  },
  "token_counter": {
    "enabled": true,
    "heuristic": { "chars_per_token": 4.0, "words_per_token": 0.75 },
    "providers": {
      "openai": { "enabled": false, "api_key_env": "OPENAI_API_KEY", "base_url": "https://api.openai.com", "count_endpoint": "/v1/tokens/count" },
      "anthropic": { "enabled": false, "api_key_env": "ANTHROPIC_API_KEY", "base_url": "https://api.anthropic.com", "count_endpoint": "/v1/messages/count_tokens" }
    }
  },
  "sessions": {
    "enabled": true,
    "paths": {
      "claude": "~/.claude/projects",
      "codex": "~/.codex/sessions",
      "omp": "~/.omp/agent/sessions",
      "crush": "~/.local/share/crush/projects.json",
      "opencode": "~/.local/share/opencode/opencode.db",
      "pi": "~/.pi/agent/sessions",
      "omo": "~/.omo/agent/sessions"
    }
  },
  "storage": {
    "token_events_retention_days": 0,
    "vacuum_after_retention": false
  },
  "scheduled_import": {
    "enabled": false,
    "interval": "24h",
    "clis": []
  },
  "otel": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:4318",
    "interval_seconds": 60
  }
}
